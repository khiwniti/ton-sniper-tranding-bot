{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/webhook",
      "destination": "/api/webhook"
    },
    {
      "source": "/api/line-webhook",
      "destination": "/api/line-webhook"
    }
  ],
  "functions": {
    "api/webhook.ts": {
      "memory": 1024,
      "maxDuration": 10
    },
    "api/line-webhook.ts": {
      "memory": 1024,
      "maxDuration": 10
    }
  }
}
